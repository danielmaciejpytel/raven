      objectReference: {fileID: 8294538149117052326, guid: 13ce3fa0b6bb2094b8056513bf54a803, type: 2}
    - target: {fileID: 4824433361684567436, guid: 8bccdb5c89aa4e84bb2d7acee44bf984, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4294967295
      objectReference: {fileID: 0}
    - target: {fileID: 4824433361684567436, guid: 8bccdb5c89aa4e84bb2d7acee44bf984, type: 3}
      propertyPath: 'm_ActiveFontFeatures.Array.data[0]'
      value: 1801810542
      objectReference: {fileID: 0}
    - target: {fileID: 4824433361684567439, guid: 8bccdb5c89aa4e84bb2d7acee44bf984, type: 3}
      propertyPath: m_LocalScale.x
      value: 0.85
      objectReference: {fileID: 0}
    - target: {fileID: 5300965507858780061, guid: 8bccdb5c89aa4e84bb2d7acee44bf984, type: 3}
      propertyPath: m_LocalScale.x
      value: 0.85
      objectReference: {fileID: 0}
    - target: {fileID: 6573653602270124610, guid: 8bccdb5c89aa4e84bb2d7acee44bf984, type: 3}
      propertyPath: m_text
      value: "Dryfujesz przez bezkresn\u0105 ciemno\u015B\u0107 poza czasem. Bunt
        i zdrada kt\xF3ra doprowadzi\u0142a do twojej \u015Bmierci wydaj\u0105 si\u0119
        tylko odleg\u0142ym, wr\u0119cz nierealnym wspomnieniem. Nagle czujesz\u2026
        b\xF3l. Zaskoczona otwierasz oczy. Ty\u2026 widzisz.            W ustach
        nadal czujesz smak morskiej wody i krwi. Pr\xF3bujesz wzi\u0105\u0107 g\u0142\u0119boki
        oddech, ale nie udaje ci si\u0119 wci\u0105gn\u0105\u0107 powietrza. Odruchowo,
        pr\xF3buj\u0105c z\u0142apa\u0107 dech, \u0142apiesz si\u0119 za szyj\u0119,
        usta, nos... "
      objectReference: {fileID: 0}
    - target: {fileID: 6573653602270124610, guid: 8bccdb5c89aa4e84bb2d7acee44bf984, type: 3}
      propertyPath: m_fontSize
      value: 72
      objectReference: {fileID: 0}
