    - target: {fileID: 4824433361684567436, guid: 8bccdb5c89aa4e84bb2d7acee44bf984, type: 3}
      propertyPath: m_text
      value: "\nCzujesz b\xF3l, kiedy s\u0142ona, morska woda wype\u0142nia twoje
        \u015Bwie\u017Ce rany.                                                                                         
        Ze swej pami\u0119ci nie mo\u017Cesz wyzby\u0107 si\u0119 zapachu krwi i
        prochu.                                                                                       
        Pr\xF3bujesz krzycze\u0107, ale jedyne co wydobywa si\u0119 z twoich ust
        to cisza, gdy twe p\u0142uca nape\u0142niaj\u0105 si\u0119 s\u0142on\u0105
        wod\u0105. \r                                                                                                                                                                                                     
        Potem przeszywa ci\u0119 ju\u017C tylko zimno, a ciemno\u015B\u0107 spowija
        oczy.                                                                                 
        Zaznajesz\u2026 spokoju.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 4824433361684567436, guid: 8bccdb5c89aa4e84bb2d7acee44bf984, type: 3}
      propertyPath: m_fontSize
      value: 72
      objectReference: {fileID: 0}
    - target: {fileID: 4824433361684567436, guid: 8bccdb5c89aa4e84bb2d7acee44bf984, type: 3}
      propertyPath: m_sharedMaterial
