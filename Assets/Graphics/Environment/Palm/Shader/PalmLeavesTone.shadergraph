{
  "m_SGVersion": 1,
  "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
  "m_ObjectId": "9e995341e797437580dc818e3dcbff3a",
  "m_Group": {
    "m_Id": ""
  },
  "m_Name": "PalmLeafNotches (Custom Function)",
  "m_DrawState": {
    "m_Expanded": true,
    "m_Position": {
      "serializedVersion": "2",
      "x": -780.0,
      "y": -160.0,
      "width": 184.0,
      "height": 253.00001525878906
    }
  },
  "m_Slots": [
    {
      "m_Id": "52d4e5a69a594972a500c14548e251ea"
    },
    {
      "m_Id": "22c51c3c228745e784c4e5916e956ce8"
    },
    {
      "m_Id": "c6751e0af3144319b19a3c2c890583aa"
    },
    {
      "m_Id": "30a8222010d245679560beb9219a10c2"
    },
    {
      "m_Id": "d7d83262ffd247d69ce662ea88a06ab1"
    },
    {
      "m_Id": "600612e11b11417da7d740ce6b2ca15a"
    },
    {
      "m_Id": "152eedafb81c49679e50e2c39a12b2c8"
    },
    {
      "m_Id": "c3b37419abff4417a46ba7516bba1183"
    },
    {
      "m_Id": "dc557f37590e44c9a4fa6c1092a50ae6"
    }
  ],
  "synonyms": [],
  "m_Precision": 1,
  "m_PreviewExpanded": false,
  "m_DismissedVersion": 0,
  "m_PreviewMode": 0,
  "m_CustomColors": {
    "m_SerializableColors": []
  },
  "m_SourceType": 1,
  "m_FunctionName": "PalmLeafNotches",
  "m_FunctionSource": "",
  "m_FunctionSourceUsePragmas": false,
  "m_FunctionBody": "// FoliageBasecolorB: two leaf islands. Cut shallow, slanted, irregular edge strips.\n// One outward alpha probe follows the authored silhouette, preserving the midrib.\nfloat2 uv = frac(UV);\nfloat island = step(0.315, uv.x);\nfloat center = lerp(0.148, 0.448, island);\nfloat side = step(center, uv.x);\nfloat direction = side * 2.0 - 1.0;\nfloat distanceToRib = abs(uv.x - center);\nfloat phase = (uv.y - Slant * distanceToRib) * Density + side * 0.43 + island * 0.27;\nfloat row = floor(phase);\nfloat random = frac(sin(row * 127.1 + side * 311.7 + island * 74.7) * 43758.5453);\nfloat width = lerp(0.19, lerp(0.10, 0.28, random), Irregularity) * Width;\nfloat depth = lerp(0.0185, lerp(0.010, 0.027, frac(random * 7.13)), Irregularity) * Depth * lerp(1.0, 0.78, island);\nfloat2 outside = uv + float2(direction * depth, 0.0);\nfloat edgeAlpha = SAMPLE_TEXTURE2D(Leaf.tex, Leaf.samplerstate, outside).a;\nfloat cutCenter = lerp(0.5, 0.18 + 0.60 * frac(random * 3.71), Irregularity);\nfloat strip = (1.0 - step(width * 0.5, abs(frac(phase) - cutCenter))) * step(0.09 * Irregularity, random);\nfloat region = step(0.105, uv.y) * (1.0 - step(0.435, uv.y)) * step(0.037, distanceToRib) * (1.0-step(0.59,uv.x));\nAlphaOut = Alpha * (1.0 - step(0.0001, Depth) * strip * region * (1.0-step(0.6,edgeAlpha)));"
}

