  - m_Id: 4794101374982
    m_Localized: "Zwi\u0119kszona szybkostrzelno\u015B\u0107\n\nNaci\u015Bnij [E]
      aby podnie\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 4794101374983
