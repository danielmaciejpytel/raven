    m_Metadata:
      m_Items: []
  - m_Id: 4794101374979
    m_Localized: "Aktywowany zmienia amunicj\u0119 na zapalaj\u0105c\u0105\nUWAGA:
      Powoli zu\u017Cywa energi\u0119\n\nNaci\u015Bnij [E] aby podnie\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 4794101374980
    m_Localized: "Zwi\u0119kszona szybkostrzelno\u015B\u0107 \nNaci\u015Bnij [E]
      aby podnie\u015B\u0107"
    m_Metadata:
